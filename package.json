{
  "name": "@vectojs/danmaku-core",
  "version": "0.3.0",
  "description": "Pure danmaku (barrage) engine primitives — object pool, kinematic lane scheduler, motion presets, and timeline track — renderer-agnostic and zero-dependency.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectojs/danmaku-core.git"
  },
  "bugs": {
    "url": "https://github.com/vectojs/danmaku-core/issues"
  },
  "homepage": "https://github.com/vectojs/danmaku-core#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "test": "bun test",
    "format:check": "oxfmt --check \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt --write \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint:biome": "biome lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "check": "bun run format:check && bun run lint && bun run lint:md",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/bun": "^1.3.0",
    "oxlint": "^1.76.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "carryctx": "0.6.1",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.64.0"
  }
}
